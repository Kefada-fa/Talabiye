# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git — never commit real keys.

# Supabase — Project URL and publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key (Project Settings → API Keys → Secret keys).
# SERVER-ONLY: bypasses all security rules. Never add NEXT_PUBLIC_ to it.
# Used by the notification sender to read the private outbox.
SUPABASE_SECRET_KEY=

# Resend (email). SERVER-ONLY. Leave empty to print emails to the console.
RESEND_API_KEY=
# Sender address on a domain verified in Resend (default: onboarding@resend.dev)
RESEND_FROM_EMAIL=

# Public address of this app, used for links in emails.
APP_URL=http://localhost:3000
